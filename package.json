    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.1.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "three": "0.180.0",
    "three-stdlib": "2.36.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.2",
    "vite": "6.0.5",
    "yaml": "2.8.1"
  }
