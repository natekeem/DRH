{
  "name": "design-reference-hub",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "audit:v1.4": "node scripts/audit-v1.4.mjs",
    "audit:design-md": "node scripts/audit-design-md.mjs",
    "sync:awesome-design-md": "node scripts/sync-awesome-design-md.mjs",
    "audit:demos": "node scripts/audit-demos.mjs",
    "audit:references": "node scripts/audit-reference-quality.mjs",
    "sync:brand-designs": "node scripts/sync-awesome-design-md.mjs --offline",
    "audit:brand-designs": "node scripts/audit-brand-designs.mjs && node tests/brand-designs/sync-qa.mjs && node scripts/audit-brand-catalog.mjs"
